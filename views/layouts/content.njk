{#
  A single piece of content in a two-thirds column.
  Blocks: heading (defaults to page.title as the h1), lead, body, aside.
#}
{% extends "layouts/base.njk" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% block heading %}
        <h1 class="govuk-heading-xl">{{ page.title }}</h1>
      {% endblock %}
      {% block lead %}{% endblock %}
      {% block body %}{% endblock %}
    </div>
    <div class="govuk-grid-column-one-third">
      {% block aside %}{% endblock %}
    </div>
  </div>
{% endblock %}
