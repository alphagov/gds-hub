{#
  A page about one record in the catalogue, such as a tool or a capability,
  using the full width beside the contents.
  page.caption, if set, is shown above the h1 (see CataloguePageViewModel).
  Blocks: heading (the caption and page.title as the h1), lead and body.
#}
{% extends "layouts/base.njk" %}

{% block pageContent %}
  {% block heading %}
    {% if page.caption %}
      <span class="govuk-caption-l">{{ page.caption }}</span>
    {% endif %}
    <h1 class="govuk-heading-l">{{ page.title }}</h1>
  {% endblock %}
  {% block lead %}{% endblock %}
  {% block body %}{% endblock %}
{% endblock %}
