{#
  linkList(items, emptyText): a list of LinkItems, each with its description if
  it has one. If there are no items, emptyText is shown instead (if given).
#}
{% macro linkList(items, emptyText) %}
  {% if items | length %}
    <ul class="govuk-list govuk-list--spaced">
      {% for item in items %}
        <li>
          <a class="govuk-link" href="{{ item.href }}">{{ item.text }}</a>
          {% if item.description %}
            <p class="govuk-body-s govuk-!-margin-top-1 govuk-!-margin-bottom-0">{{ item.description }}</p>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% elif emptyText %}
    <p class="govuk-body">{{ emptyText }}</p>
  {% endif %}
{% endmacro %}
