{#
  Every page extends this layout, usually through content.njk or listing.njk.
  Context:
    page    the view model for the page (see src/view-models.ts)
    layout  per-request layout data built by src/lib/render.ts
  Blocks you can override, as well as those in govuk/template.njk:
    breadcrumbs  replaces the breadcrumbs built from page.breadcrumbs
    pageContent  the page's own content, beside the contents if page.contents has any groups.
                 Don't override "main" or "content": govuk/template.njk's main block holds
                 the <main> element, and content holds the grid with the contents column.
#}
{% extends "govuk/template.njk" %}

{% from "govuk/components/breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "govuk/components/generic-header/macro.njk" import govukGenericHeader %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}

{% block pageTitle %}{{ layout.documentTitle }}{% endblock %}

{% block head %}
  <link rel="stylesheet" href="{{ layout.assets.stylesheet }}">
  <link rel="stylesheet" href="{{ layout.assets.applicationStylesheet }}">
{% endblock %}

{#
  The Hub isn't a GOV.UK service, so it uses the generic header with the
  service name in place of the GOV.UK logo. The service name is not repeated
  in the service navigation.
#}
{% block govukHeader %}
  {{ govukGenericHeader({
    url: layout.homePath,
    logoText: layout.serviceName
  }) }}
{% endblock %}

{% block govukServiceNavigation %}
  {{ govukServiceNavigation({
    navigation: layout.navigation
  }) }}
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: { text: "Beta" },
    text: "This is a new service."
  }) }}
  {% block breadcrumbs %}
    {% if page.breadcrumbs | length %}
      {{ govukBreadcrumbs({ items: page.breadcrumbs }) }}
    {% endif %}
  {% endblock %}
{% endblock %}

{#
  The left-hand contents takes a quarter of the width from the desktop
  breakpoint up. Below it, the contents sits above the page content.
#}
{% block content %}
  {% set hasContents = page.contents and page.contents.groups | length %}
  <div class="govuk-grid-row">
    {% if hasContents %}
      <div class="govuk-grid-column-one-quarter-from-desktop">
        {% include "partials/contents-navigation.njk" %}
      </div>
    {% endif %}
    <div class="{{ 'govuk-grid-column-three-quarters-from-desktop' if hasContents else 'govuk-grid-column-full' }}">
      {% block pageContent %}{% endblock %}
    </div>
  </div>
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="{{ layout.assets.applicationScript }}"></script>
{% endblock %}
