{
  "name": "gds-hub",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Internal documentation tool for GDS",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/db/scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx src/db/scripts/seed.ts",
    "db:reset": "node --env-file-if-exists=.env --import tsx src/db/scripts/reset.ts"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "govuk-frontend": "^6.6.0",
    "helmet": "^8.3.0",
    "nunjucks": "^3.2.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nunjucks": "^3.2.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
