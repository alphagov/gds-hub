# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_VERSION=local
DATABASE_URL=postgres://gdshub:gdshub@localhost:5432/gdshub

# Host ports used by docker compose. Change these if something on your
# machine already uses them, and update the port in DATABASE_URL to match.
APP_HOST_PORT=3000
DB_HOST_PORT=5432

# Data migration from the current Hub (docs/migration.md). Each input is a
# folder outside this repository, or an s3://bucket/prefix/ address. Leave
# these unset unless you are running it.
# HUB_DATA_DIR=/path/outside/this/repo/hub-data
# HUB_BUILD_DIR=/path/outside/this/repo/hub-build
# MIGRATION_CONTENT_SELECTOR=main
# MIGRATION_STRIP_SELECTORS=
# MIGRATION_SITE_ORIGIN=
# MIGRATION_ASSET_BASE_PATH=/hub-assets
# MIGRATION_REPORT_DIR=migration-reports
# Only for a database that isn't local, such as RDS. Must be the host in DATABASE_URL.
# MIGRATION_DATABASE_HOST=
