{% extends "layouts/catalogue.njk" %}
{% from "partials/link-list.njk" import linkList %}

{% block heading %}
  <h1 class="govuk-heading-xl">{{ page.title }}</h1>
{% endblock %}

{% block lead %}
  <p class="govuk-body-l">{{ page.description }}</p>
{% endblock %}

{% block body %}
  {% for group in page.groups %}
    <h2 class="govuk-heading-m">
      {% if group.href %}
        <a class="govuk-link" href="{{ group.href }}">{{ group.heading }}</a>
      {% else %}
        {{ group.heading }}
      {% endif %}
    </h2>
    {{ linkList(group.items) }}
  {% else %}
    <p class="govuk-body">No products, teams or services have been added yet.</p>
  {% endfor %}
{% endblock %}
